# MongoDB connection string (MongoDB Atlas free tier works fine)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/
MONGODB_DB=lifeguard

# Password for the /admin page where you view leads and download PDFs
ADMIN_PASSWORD=change-me-to-something-long

# 64 hex chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# KEEP A BACKUP — if this is lost, saved PAN/Aadhaar/bank details and PDFs cannot be decrypted.
ENCRYPTION_KEY=

# Printed on the top-right of every generated PDF
AGENT_NAME=Love Maggo
AGENT_CODE=3594

PORT=5000
